<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 gives access to WinRT APIs (Windows.Media.Ocr) from WPF via CsWinRT. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>CompleteScanner.App</RootNamespace>
    <AssemblyName>CompleteScanner</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Explorer, the taskbar and Alt+Tab; the windows load the same file as a resource. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CompleteScanner.Core\CompleteScanner.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TWAIN (Scanning/Twain). MIT licensed, no dependencies; pinned to an exact version.
         The TWAIN Data Source Manager it loads (TWAINDSM.dll, LGPL) is never shipped with
         the app: scanner drivers install it. -->
    <PackageReference Include="NTwain" Version="[3.7.6]" />
    <!-- Barcode and QR separator sheets (Services/ZXingBarcodeReader.cs, ZXingQrEncoder.cs).
         Apache-2.0, no dependencies; the core package only, fed the page's gray pixels, so no
         image-binding package is needed. Pinned to an exact version. -->
    <PackageReference Include="ZXing.Net" Version="[0.16.11]" />
  </ItemGroup>

</Project>
