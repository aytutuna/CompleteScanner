<UserControl x:Class="CompleteScanner.App.TaskStartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompleteScanner.App">
    <!-- The start screen: what are you scanning? One card per task, then the user's own presets.
         Each group of cards is one Tab stop; the arrow keys move between its cards and Enter or
         Space opens one. The header and the grids share side insets that centre the grid
         (see UpdateInsets), like the Scans and Saved tabs. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Focusable="False" ScrollChanged="Scroller_ScrollChanged">
        <StackPanel Margin="0,0,0,16">
            <DockPanel x:Name="Header" Margin="16,20,16,4">
                <Button DockPanel.Dock="Right" x:Name="GoToScanButton" Style="{StaticResource IconTextButtonStyle}"
                        local:Icon.Glyph="&#xE8FE;" Content="Go to Scan" VerticalAlignment="Top" Margin="16,4,0,0"
                        ToolTip="Open the scan screen with the settings as they are"
                        Click="GoToScan_Click" />
                <StackPanel>
                    <TextBlock Text="What are you scanning?" Style="{StaticResource TitleText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Pick a task and everything is set up for it. Every setting can still be changed on the Scan screen."
                               Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="TasksHeader" Text="Tasks" Style="{StaticResource SectionHeaderText}" Margin="16,16,16,2" />
            <ItemsControl x:Name="TaskGrid" Margin="10,0,10,0" Focusable="False"
                          AutomationProperties.Name="Tasks"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Card" Style="{StaticResource TaskCardButtonStyle}" Click="TaskCard_Click"
                                IsEnabled="{Binding IsAvailable}"
                                AutomationProperties.Name="{Binding Title}"
                                AutomationProperties.HelpText="{Binding HelpText}">
                            <Button.ToolTip>
                                <TextBlock x:Name="TipText" Text="{Binding Subtitle}" TextWrapping="Wrap" MaxWidth="280" />
                            </Button.ToolTip>
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <Border x:Name="CurrentTag" DockPanel.Dock="Right" Style="{StaticResource AccentTagStyle}"
                                            Visibility="Collapsed">
                                        <TextBlock Text="Current" Style="{StaticResource AccentTagText}" />
                                    </Border>
                                    <Border Style="{StaticResource TaskIconBadgeStyle}">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource TaskIconGlyphStyle}" />
                                    </Border>
                                </DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource BodyStrongText}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,12,0,2" />
                                <!-- Footer: what the task sets, or why it cannot be started. -->
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <TextBlock x:Name="FooterGlyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}"
                                               FontSize="12" Text="&#xE946;" Margin="0,1,6,0" VerticalAlignment="Top"
                                               Visibility="Collapsed" />
                                    <!-- Up to two lines, as on macOS: two-sided scanning by hand makes the line long. -->
                                    <TextBlock x:Name="Footer" Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"
                                               Typography.NumeralAlignment="Tabular" />
                                </DockPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="CurrentTag" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="Footer" Property="Text" Value="{Binding Reason}" />
                                <Setter TargetName="Footer" Property="TextWrapping" Value="Wrap" />
                                <Setter TargetName="FooterGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="TipText" Property="Text" Value="{Binding Reason}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="PresetsHeader" Text="My presets" Style="{StaticResource SectionHeaderText}" Margin="16,16,16,2" />
            <TextBlock x:Name="NoPresetsText" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap"
                       Margin="16,4,16,0"
                       Text="Settings you save as a preset (the + next to Presets in the side pane) appear here." />
            <ItemsControl x:Name="PresetGrid" Margin="10,0,10,0" Focusable="False"
                          AutomationProperties.Name="My presets"
                          KeyboardNavigation.TabNavigation="Once"
                          KeyboardNavigation.DirectionalNavigation="Contained">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TaskCardButtonStyle}" Height="148" Click="PresetCard_Click"
                                ToolTip="{Binding Name}"
                                AutomationProperties.Name="{Binding Name}"
                                AutomationProperties.HelpText="{Binding HelpText}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource TaskIconBadgeStyle}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TaskIconGlyphStyle}" />
                                </Border>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" Style="{StaticResource BodyStrongText}"
                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" Margin="0,12,0,2" />
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{Binding TaskTitle}" Style="{StaticResource CaptionText}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
