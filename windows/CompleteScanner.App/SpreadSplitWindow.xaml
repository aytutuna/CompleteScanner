<Window x:Class="CompleteScanner.App.SpreadSplitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CompleteScanner.App"
        Title="Split the spread"
        Width="820" Height="680" MinWidth="560" MinHeight="460"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- Header: title and what to do. -->
        <StackPanel DockPanel.Dock="Top" Margin="20,14,20,12">
            <TextBlock x:Name="TitleText" Text="Split the spread" Style="{StaticResource SubtitleText}" TextWrapping="NoWrap" />
            <DockPanel Margin="0,4,0,0" HorizontalAlignment="Left">
                <ui:InfoButton DockPanel.Dock="Right" Label="keyboard use" Heading="Keyboard" Margin="4,-4,0,-4"
                               InfoText="Arrow keys move the cut; Shift takes bigger steps. If the book lay on its side, choose Stacked." />
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Drag to place the cut at the spine." />
            </DockPanel>
        </StackPanel>

        <!-- Footer: how the pages lie and the slider; keep as one page on the left, Cancel and the primary Split on the right. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="20,8,20,16">
            <Border Style="{StaticResource SegmentedTrackStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"
                    AutomationProperties.Name="How the pages lie">
                <UniformGrid Rows="1" Columns="2">
                    <RadioButton x:Name="SideBySideButton" Style="{StaticResource SegmentedTextItemStyle}"
                                 Content="Side by side" Padding="12,4,12,5"
                                 ToolTip="Spine runs up and down" Checked="Axis_Changed" />
                    <RadioButton x:Name="StackedButton" Style="{StaticResource SegmentedTextItemStyle}"
                                 Content="Stacked" Padding="12,4,12,5"
                                 AutomationProperties.Name="One above the other"
                                 ToolTip="Spine runs across (book on its side)" Checked="Axis_Changed" />
                </UniformGrid>
            </Border>
            <Slider x:Name="CutSlider" Minimum="0.05" Maximum="0.95" SmallChange="0.002" LargeChange="0.02"
                    AutomationProperties.Name="Where the spread is cut" ValueChanged="CutSlider_ValueChanged" />
            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button x:Name="KeepWholeButton" DockPanel.Dock="Left" Content="Keep as one page" Style="{StaticResource SubtleButtonStyle}"
                        ui:Icon.Glyph="&#xE8A5;" Margin="-11,0,0,0" Click="KeepWhole_Click"
                        AutomationProperties.HelpText="Join the two pages: the spread is saved as one page." />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" IsCancel="True" MinWidth="96" />
                    <Button x:Name="SplitButton" Content="Split" IsDefault="True" MinWidth="96" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}" Click="Split_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Neutral stage: the spread as scanned, the cut drawn across it. -->
        <Border Style="{StaticResource StageStyle}" Margin="12,0,12,0">
            <Canvas x:Name="Host" Background="Transparent" ClipToBounds="True"
                    Focusable="True" KeyDown="Host_KeyDown"
                    FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                    AutomationProperties.Name="Spread"
                    AutomationProperties.HelpText="Arrow keys move the cut; Shift takes bigger steps. If the book lay on its side, choose Stacked."
                    MouseLeftButtonDown="Host_MouseDown" MouseMove="Host_MouseMove"
                    MouseLeftButtonUp="Host_MouseUp" LostMouseCapture="Host_LostMouseCapture"
                    SizeChanged="Host_SizeChanged">
                <Image x:Name="DisplayImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"
                       Effect="{DynamicResource PageShadow}" />
                <Line x:Name="CutLine" Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                      StrokeDashArray="4 2" IsHitTestVisible="False" />
            </Canvas>
        </Border>
    </DockPanel>
</Window>
