<UserControl x:Class="CompleteScanner.App.SavedFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CompleteScanner.App">
    <UserControl.Resources>
        <!-- File type label in the corner of a thumbnail. -->
        <Style x:Key="TypeBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="6,1,6,2" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="TypeBadgeText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- One card. Its thumbnail is decoded when the card is realized and dropped when the
             card scrolls out of the virtualized list (Card_Loaded / Card_Unloaded). The width
             and margin match CardSlotWidth in code. The action bar is hidden by Opacity only,
             so its buttons stay reachable with Tab; it shows on hover and on keyboard focus.
             Every action on the file is also in the card's context menu (right-click, Shift+F10
             or the Menu key on any of its buttons) and in the bar's More menu. -->
        <DataTemplate x:Key="CardTemplate">
            <Grid x:Name="Card" Width="200" Margin="6" Background="Transparent"
                  Loaded="Card_Loaded" Unloaded="Card_Unloaded"
                  ContextMenuOpening="Card_ContextMenuOpening">
                <!-- Replaced by the file's menu as it opens (Card_ContextMenuOpening). -->
                <Grid.ContextMenu>
                    <ContextMenu />
                </Grid.ContextMenu>
                <!-- Solid layer behind the translucent card that carries the hover shadow. -->
                <Border x:Name="Elevation" CornerRadius="{StaticResource CardCornerRadius}" Visibility="Hidden"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                <Border x:Name="Surface" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Height="140" Cursor="Hand" ToolTip="Double-click to open"
                              MouseLeftButtonDown="Thumbnail_MouseDown">
                            <Border Style="{StaticResource ImageWellStyle}" />
                            <TextBlock x:Name="Placeholder" Text="{Binding PlaceholderGlyph}"
                                       Style="{StaticResource GlyphText}" FontSize="36"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" Visibility="Collapsed" />
                            <Border x:Name="Page" Margin="10" BorderThickness="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Border Style="{StaticResource TypeBadgeStyle}">
                                <TextBlock Text="{Binding TypeText}" Style="{StaticResource TypeBadgeText}" />
                            </Border>
                            <Border x:Name="Actions" Style="{StaticResource HoverActionBarStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE8A7;"
                                            Click="Open_Click" ToolTip="Open with the default app"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}" />
                                    <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE72D;"
                                            Click="Share_Click" ToolTip="Share: send with Mail, Outlook, nearby sharing or another app"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Share {0}'}" />
                                    <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE838;"
                                            Click="Reveal_Click" ToolTip="Show in File Explorer"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Show {0} in File Explorer'}" />
                                    <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE7AD;"
                                            Click="Rotate_Click" ToolTip="Rotate the saved file 90° clockwise"
                                            AutomationProperties.Name="{Binding Name, StringFormat='Rotate {0} 90° clockwise'}"
                                            Visibility="{Binding RotateVisibility}"
                                            IsEnabled="{Binding CanRotate}" />
                                    <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE712;"
                                            Click="More_Click" ToolTip="More: open with, email, copy"
                                            AutomationProperties.Name="{Binding Name, StringFormat='More actions for {0}'}"
                                            AutomationProperties.HelpText="Opens a menu: open, open with, show in folder, share, email, copy" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" Margin="2,8,2,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <DockPanel Margin="2,2,2,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                       Margin="8,0,0,0" TextWrapping="NoWrap" Typography.NumeralAlignment="Tabular" />
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource CaptionText}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter TargetName="Elevation" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Elevation" Property="Effect" Value="{DynamicResource CardHoverShadow}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Same header as the Scans tab: title and caption, actions on the right, all lined up
             with the centred card grid (see UpdateInsets). -->
        <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="16,16,16,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,-11,0">
                <Button Style="{StaticResource SubtleButtonStyle}" local:Icon.Glyph="&#xE838;"
                        Content="Show in Explorer" ToolTip="Open the destination folder in File Explorer"
                        Click="RevealFolder_Click" />
                <Button Style="{StaticResource SubtleButtonStyle}" local:Icon.Glyph="&#xE72C;"
                        Content="Refresh" Margin="4,0,0,0" ToolTip="Re-read the destination folder"
                        Click="Refresh_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FolderName" Style="{StaticResource SubtitleText}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <!-- The full path, shortened in the middle to fit (see FitFolderText). -->
                <TextBlock x:Name="FolderText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           SizeChanged="FolderText_SizeChanged" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- Rows of cards in a virtualizing list: only the rows on screen (plus a small
                 cache) exist, so a folder with thousands of files stays cheap. The rows are
                 re-cut when the width changes (see RebuildRows). -->
            <ItemsControl x:Name="Rows" Margin="0,0,0,6"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          SizeChanged="Rows_SizeChanged" ScrollViewer.ScrollChanged="Rows_ScrollChanged">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True" Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                      Margin="{Binding RowInset, RelativeSource={RelativeSource AncestorType=local:SavedFilesView}}"
                                      ItemTemplate="{StaticResource CardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel x:Name="EmptyState" Style="{StaticResource EmptyStatePanelStyle}" Visibility="Collapsed">
                <Border Style="{StaticResource EmptyStateCircleStyle}">
                    <TextBlock x:Name="EmptyGlyph" Text="&#xE8B7;" Style="{StaticResource EmptyStateGlyphStyle}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" Text="Nothing saved yet" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock x:Name="EmptyBody" Style="{StaticResource EmptyStateBodyStyle}"
                           Text="Scans you save to this folder appear here, newest first." />
                <TextBlock x:Name="EmptyFolder" Style="{StaticResource CaptionText}" Margin="0,12,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
