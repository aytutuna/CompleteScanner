<Window x:Class="CompleteScanner.App.AddScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CompleteScanner.App"
        Title="Add scanner by address"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddButton" Content="Add" IsDefault="True" MinWidth="96"
                        Style="{StaticResource AccentButtonStyle}" Click="Add_Click" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="Add a network scanner" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <!-- One line; where to find the address and the forms it can take are behind the ⓘ. -->
            <DockPanel Margin="0,6,0,16" HorizontalAlignment="Left">
                <ui:InfoButton x:Name="AddressInfoButton" DockPanel.Dock="Right" Label="the scanner's address" Margin="4,-2,0,-2"
                               InfoText="Most network scanners appear on their own. The address is on the scanner's screen or its network settings page. Forms: 192.168.1.50, scanner.local, 192.168.1.50:8080, https://192.168.1.50." />
                <TextBlock Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Enter the scanner's IP address or name." />
            </DockPanel>

            <TextBlock x:Name="AddressLabel" Text="Address" Style="{StaticResource FieldLabelText}" />
            <Grid>
                <TextBox x:Name="AddressBox" AutomationProperties.LabeledBy="{Binding ElementName=AddressLabel}"
                         AutomationProperties.HelpText="For example 192.168.1.50, scanner.local, 192.168.1.50:8080 or https://192.168.1.50"
                         TextChanged="AddressBox_TextChanged" />
                <TextBlock x:Name="AddressPlaceholder" Style="{StaticResource PlaceholderText}"
                           Text="e.g. 192.168.1.50 or scanner.local" />
            </Grid>

            <!-- Progress and errors; announced to screen readers as they change. -->
            <DockPanel x:Name="StatusPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock x:Name="StatusGlyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}"
                           Text="&#xEB90;" Margin="0,1,8,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <StackPanel>
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Assertive" />
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Collapsed"
                                 AutomationProperties.Name="Connecting" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
