<Window x:Class="CompleteScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CompleteScanner.App"
        xmlns:core="clr-namespace:CompleteScanner.Core;assembly=CompleteScanner.Core"
        Title="CompleteScanner"
        Width="1200" Height="800" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="{x:Static local:AppIcon.Image}"
        FontFamily="{StaticResource TextFontFamily}">
    <Window.Resources>
        <Style x:Key="SectionExpanderStyle" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Margin" Value="{StaticResource SectionSpacing}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="SliderLabelText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallIconButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The InfoBars: outside MainContent, so they stay usable while the photo review is open. -->
        <StackPanel Grid.Row="0">
            <!-- Errors. -->
            <Border x:Name="InfoBar" Style="{StaticResource InfoBarStyle}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xEB90;" Margin="0,0,12,0"
                               VerticalAlignment="Top" Padding="0,2,0,0"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Top"
                            Click="InfoBarClose_Click" />
                    <!-- Shown when the error is a scanner that would not connect or scan. -->
                    <Button DockPanel.Dock="Right" x:Name="InfoBarTroubleshootButton" Style="{StaticResource SubtleButtonStyle}"
                            local:Icon.Glyph="&#xE9CE;" Content="Troubleshoot" VerticalAlignment="Top" Margin="8,0,4,0"
                            Visibility="Collapsed"
                            ToolTip="Why isn't my scanner listed or working? Checks what can stop it"
                            AutomationProperties.HelpText="Opens the troubleshooter: checks what stops scanners from appearing or connecting"
                            Click="Troubleshoot_Click" />
                    <TextBlock x:Name="InfoBarText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"><Run
                            Text="Something went wrong" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="InfoBarMessage" /></TextBlock>
                </DockPanel>
            </Border>

            <!-- After a save: what was saved, with what can be done with it. Hidden by its close
                 button or when the next scan starts. The buttons fold to their glyphs in narrow
                 windows (SavedBar_SizeChanged); their names stay in tooltips and for screen readers. -->
            <Border x:Name="SavedBar" Style="{StaticResource SavedBarStyle}" Visibility="Collapsed"
                    SizeChanged="SavedBar_SizeChanged">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE930;" Margin="0,0,12,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE711;"
                            ToolTip="Dismiss" AutomationProperties.Name="Dismiss" VerticalAlignment="Center"
                            Margin="4,0,0,0" Click="SavedBarClose_Click" />
                    <StackPanel DockPanel.Dock="Right" x:Name="SavedBarButtons" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button x:Name="SavedOpenButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE8A7;" Content="Open" Tag="Open"
                                ToolTip="Open with the default app" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedRevealButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE838;" Content="Show in folder" Tag="Reveal"
                                ToolTip="Show in File Explorer" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedShareButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE72D;" Content="Share" Tag="Share"
                                ToolTip="Send with Mail, Outlook, nearby sharing or another app" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedCopyButton" Style="{StaticResource SubtleButtonStyle}"
                                local:Icon.Glyph="&#xE8C8;" Content="Copy" Tag="Copy"
                                ToolTip="Copy to the clipboard" Click="SavedBarAction_Click" />
                        <Button x:Name="SavedMoreButton" Style="{StaticResource SmallIconButtonStyle}" Content="&#xE712;"
                                Width="32" Height="32"
                                ToolTip="More: open with, email" AutomationProperties.Name="More actions"
                                AutomationProperties.HelpText="Opens a menu: open with, email and the other actions"
                                Click="SavedBarMore_Click" />
                    </StackPanel>
                    <TextBlock x:Name="SavedBarText" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite"><Run
                            Text="Saved" FontWeight="SemiBold" /><Run Text="  " /><Run x:Name="SavedBarMessage" /></TextBlock>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel Grid.Row="1" x:Name="MainContent">
            <!-- Sidebar: scanners + presets, directly on the window backdrop. Below a width
                 threshold it folds to an icon rail (see UpdatePane); names stay in tooltips. -->
            <Grid DockPanel.Dock="Left" x:Name="Sidebar" Width="216">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <Button DockPanel.Dock="Left" x:Name="PaneToggleButton" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE700;" Width="40" Height="36" Margin="4,4,0,4" Visibility="Collapsed"
                            ToolTip="Show scanner and preset names"
                            AutomationProperties.Name="Show scanner and preset names"
                            Click="PaneToggle_Click" />
                    <Button DockPanel.Dock="Right" x:Name="TroubleshootButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE9CE;" Margin="0,4,8,0" VerticalAlignment="Center"
                            ToolTip="Why isn't my scanner listed?"
                            AutomationProperties.Name="Why isn't my scanner listed?"
                            AutomationProperties.HelpText="Opens the troubleshooter: checks what stops scanners from appearing"
                            Click="Troubleshoot_Click" />
                    <Button DockPanel.Dock="Right" x:Name="AddScannerButton" Style="{StaticResource SmallIconButtonStyle}"
                            Content="&#xE710;" Margin="0,4,2,0" VerticalAlignment="Center"
                            ToolTip="Add a network scanner by its address"
                            AutomationProperties.Name="Add scanner by address"
                            Click="AddScanner_Click" />
                    <TextBlock x:Name="ScannersHeader" Text="Scanners" Style="{StaticResource BodyStrongText}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="16,8,16,6"
                               VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Grid.Row="1" x:Name="DeviceList" Style="{StaticResource NavListBoxStyle}" MaxHeight="220"
                         ItemContainerStyle="{StaticResource DeviceListItemStyle}"
                         KeyboardNavigation.TabNavigation="Local"
                         AutomationProperties.Name="Scanners"
                         SelectionChanged="DeviceList_SelectionChanged"
                         ContextMenuOpening="DeviceList_ContextMenuOpening">
                    <!-- One row per scanner (DeviceRow). A scanner reached several ways (WIA, TWAIN,
                         network) shows its connection as a "via WIA" menu button instead of a caption;
                         the row's context menu offers the same choices (also in the folded rail). -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <DockPanel.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel.ToolTip>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource GlyphText}"
                                           Text="&#xE8FE;" Margin="0,0,12,0" />
                                <StackPanel x:Name="Texts">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="CaptionLine" Text="{Binding Caption}" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <Button x:Name="ConnectionButton" Style="{StaticResource ConnectionChooserButtonStyle}"
                                            Content="{Binding Caption}" Visibility="Collapsed"
                                            IsTabStop="{Binding IsTabStop, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            ToolTip="Choose how to connect to this scanner"
                                            AutomationProperties.Name="{Binding ConnectionChooserName}"
                                            AutomationProperties.HelpText="Opens a menu: Automatic, or one of the ways this scanner is connected"
                                            Click="ConnectionButton_Click" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasConnectionChoice}" Value="True">
                                    <Setter TargetName="CaptionLine" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ConnectionButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPaneCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                    <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- The empty state while no scanner but the demo scanner is listed (shown from code:
                     UpdateEmptyDevicesHint); the buttons in the header offer the same. -->
                <TextBlock Grid.Row="2" x:Name="EmptyDevicesHint" Margin="16,4" TextWrapping="Wrap"
                           Style="{StaticResource CaptionText}" Visibility="Collapsed"><Run
                        Text="No scanner found yet. Check that the scanner is on and connected." /><LineBreak /><Hyperlink
                        x:Name="EmptyTroubleshootLink" Click="Troubleshoot_Click">Why isn't my scanner listed?</Hyperlink><LineBreak /><Hyperlink
                        x:Name="EmptyAddScannerLink" Click="AddScanner_Click">Add a network scanner by address…</Hyperlink>
                </TextBlock>

                <DockPanel Grid.Row="3" x:Name="PresetsHeader" Margin="16,16,8,4">
                    <StackPanel DockPanel.Dock="Right" x:Name="PresetButtons" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE710;"
                                ToolTip="Save the current settings as a preset"
                                AutomationProperties.Name="Save the current settings as a preset"
                                Click="SavePreset_Click" />
                        <Button Style="{StaticResource SmallIconButtonStyle}" Content="&#xE74D;"
                                ToolTip="Delete the selected preset"
                                AutomationProperties.Name="Delete the selected preset"
                                Click="DeletePreset_Click" />
                    </StackPanel>
                    <TextBlock Text="Presets" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <!-- Takes the presets header's place in the icon rail. -->
                <Border Grid.Row="3" x:Name="PresetsDivider" Height="1" Margin="12,12,12,8" Visibility="Collapsed"
                        Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <ListBox Grid.Row="4" x:Name="PresetList" Style="{StaticResource NavListBoxStyle}"
                         AutomationProperties.Name="Presets"
                         MouseDoubleClick="PresetList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <DockPanel.ToolTip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="Double-click to apply" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </DockPanel.ToolTip>
                                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphText}">
                                            <Setter Property="Text" Value="&#xE8A5;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.Intent}" Value="Photo">
                                                    <Setter Property="Text" Value="&#xEB9F;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel x:Name="Texts">
                                    <!-- Up to two lines: one line cut most names to what the caption repeats. -->
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40" />
                                    <TextBlock Text="{Binding Converter={StaticResource PresetSummaryConverter}}"
                                               Style="{StaticResource CaptionText}" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPaneCompact, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="True">
                                    <Setter TargetName="Texts" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="5" x:Name="AppearanceButton" Style="{StaticResource SubtleButtonStyle}"
                        local:Icon.Glyph="&#xE793;" Content="Appearance"
                        ToolTip="Light, dark, or follow Windows"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="4,4,4,8"
                        Click="AppearanceButton_Click" />
            </Grid>

            <TabControl x:Name="MainTabs" Style="{StaticResource PivotTabControlStyle}"
                        SelectionChanged="MainTabs_SelectionChanged">
                <!-- Start: what are you scanning? Task cards and the user's presets. -->
                <TabItem Header="Start" x:Name="StartTab" local:Icon.Glyph="&#xE80F;">
                    <local:TaskStartView x:Name="StartView" />
                </TabItem>

                <!-- Scan: preview canvas + page strip, with the inspector on the right -->
                <TabItem Header="Scan" x:Name="ScanTab" local:Icon.Glyph="&#xE8FE;">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- The active task: what to do now. Change task goes back to the start
                                 screen; the close button leaves the task, keeping its settings. -->
                            <Border Grid.Row="0" x:Name="TaskBanner" Style="{StaticResource TaskBannerStyle}"
                                    Margin="12,12,12,0" Visibility="Collapsed" SizeChanged="TaskBanner_SizeChanged">
                                <GroupBox x:Name="TaskBannerGroup" Style="{StaticResource TaskBannerGroupStyle}"
                                          AutomationProperties.LiveSetting="Polite">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="ExitTaskButton" Style="{StaticResource SmallIconButtonStyle}"
                                                Content="&#xE711;" VerticalAlignment="Center" Margin="2,0,0,0"
                                                ToolTip="Leave the task. Its settings stay, without the guidance."
                                                AutomationProperties.Name="Leave the task"
                                                Click="ExitTask_Click" />
                                        <Button DockPanel.Dock="Right" x:Name="ChangeTaskButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE80F;" Content="Change task" VerticalAlignment="Center"
                                                Margin="8,0,0,0" ToolTip="Pick another task on the start screen"
                                                Click="ChangeTask_Click" />
                                        <Border DockPanel.Dock="Left" x:Name="TaskBannerBadge" Style="{StaticResource TaskIconBadgeStyle}"
                                                Width="32" Height="32" VerticalAlignment="Center" CornerRadius="6">
                                            <TextBlock x:Name="TaskBannerGlyph" Style="{StaticResource TaskIconGlyphStyle}" FontSize="16" />
                                        </Border>
                                        <StackPanel x:Name="TaskBannerTexts" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TaskBannerTitle" Style="{StaticResource BodyStrongText}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="TaskBannerPrompt" Style="{StaticResource SecondaryBodyText}"
                                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                            <!-- Turning a stack over by hand: moving on from the fronts, the
                                                 backs' choices, and the count mismatch ("3 fronts but 2 backs")
                                                 when there is one. -->
                                            <StackPanel x:Name="SidesActions" Visibility="Collapsed" Margin="0,6,0,0">
                                                <DockPanel x:Name="SidesNotice" Visibility="Collapsed" Margin="0,0,0,4">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="SidesNoticeText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                                               AutomationProperties.LiveSetting="Assertive" />
                                                </DockPanel>
                                                <WrapPanel Margin="-11,0,0,0">
                                                    <Button x:Name="FinishFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8AB;" Content="Done with fronts" Margin="0,0,4,0"
                                                            ToolTip="Every front side is scanned: turn the stack over and scan the back sides"
                                                            Click="FinishFronts_Click" />
                                                    <Button x:Name="CombineSidesButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE73E;" Content="Combine anyway" Margin="0,0,4,0"
                                                            ToolTip="Put the pages in order as they are; the extra pages go at the end"
                                                            Click="CombineSides_Click" />
                                                    <Button x:Name="ScanBacksAgainButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE72C;" Content="Scan back sides again" Margin="0,0,4,0"
                                                            ToolTip="Remove the back sides scanned so far and scan them again"
                                                            Click="ScanBacksAgain_Click" />
                                                    <Button x:Name="MoreFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE710;" Content="Scan more fronts" Margin="0,0,4,0"
                                                            ToolTip="The stack did not fit in the feeder: scan the fronts of the other sheets before turning it over"
                                                            Click="MoreFronts_Click" />
                                                    <Button x:Name="KeepFrontsButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8A5;" Content="Keep fronts only"
                                                            ToolTip="Leave out the back sides: the fronts stay as they are"
                                                            Click="KeepFronts_Click" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <!-- A step that may be left out (the back of a card with
                                                 nothing printed on it). -->
                                            <WrapPanel x:Name="StepActions" Visibility="Collapsed" Margin="-11,6,0,0">
                                                <Button x:Name="SkipStepButton" Style="{StaticResource SubtleButtonStyle}"
                                                        local:Icon.Glyph="&#xE72A;" Content="Skip"
                                                        Click="SkipStep_Click" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </GroupBox>
                            </Border>

                            <!-- Stage: the page sits on a neutral surface with a soft shadow. -->
                            <Border Grid.Row="1" Style="{StaticResource StageStyle}" Margin="12,12,12,0">
                                <Grid x:Name="CanvasHost"
                                      MouseLeftButtonDown="Canvas_MouseDown"
                                      MouseMove="Canvas_MouseMove"
                                      MouseLeftButtonUp="Canvas_MouseUp"
                                      LostMouseCapture="Canvas_LostMouseCapture"
                                      SizeChanged="CanvasHost_SizeChanged"
                                      Background="Transparent">
                                    <!-- The margin must stay uniform: DisplayedImageRect reads Margin.Left for every side. -->
                                    <Image x:Name="CanvasImage" Stretch="Uniform" Margin="24"
                                           Effect="{DynamicResource PageShadow}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Canvas x:Name="SelectionOverlay" IsHitTestVisible="False">
                                        <Rectangle x:Name="SelectionMarquee"
                                                   Stroke="{DynamicResource AccentFillColorDefaultBrush}" StrokeThickness="2"
                                                   StrokeDashArray="4 3" Fill="{DynamicResource MarqueeFillBrush}"
                                                   Visibility="Collapsed" />
                                    </Canvas>
                                    <StackPanel x:Name="CanvasHint" Style="{StaticResource EmptyStatePanelStyle}">
                                        <Border x:Name="CanvasHintGlyph" Style="{StaticResource EmptyStateCircleStyle}">
                                            <TextBlock Style="{StaticResource EmptyStateGlyphStyle}" Text="&#xE8FE;" />
                                        </Border>
                                        <TextBlock x:Name="CanvasHintTitle" Text="Ready to scan"
                                                   Style="{StaticResource EmptyStateTitleStyle}" />
                                        <TextBlock Style="{StaticResource EmptyStateBodyStyle}"
                                                   Text="Place a document or photos on the glass, then press Preview for a quick look or Scan to capture." />
                                        <TextBlock x:Name="CanvasHintTip" Style="{StaticResource CaptionText}" TextAlignment="Center"
                                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="After a preview, drag over it to scan just that area." />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Page strip -->
                            <Border Grid.Row="2" x:Name="PageStrip" Background="Transparent" Visibility="Collapsed"
                                    Padding="12,8,12,8">
                                <StackPanel>
                                    <TextBlock x:Name="PageStripLabel" Text="0 pages" Style="{StaticResource CaptionText}"
                                               TextWrapping="NoWrap" Margin="2,0,0,6" />
                                    <!-- Tab walks through every page's buttons (a ListBox would
                                         otherwise take one tab stop and skip them). -->
                                    <ListBox x:Name="PageList" Height="158"
                                             AutomationProperties.Name="Pages in queue"
                                             KeyboardNavigation.TabNavigation="Continue"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             BorderThickness="0" Background="Transparent" Padding="0,0,0,16"
                                             ItemContainerStyle="{StaticResource ThumbnailListItemStyle}">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <!-- The gap before the page, shown while the strip shows documents:
                                                         one click starts a new document here or joins the page to the
                                                         document before. A document's start is drawn as a bar. -->
                                                    <Button x:Name="BreakButton" DockPanel.Dock="Left" Width="10" Margin="0,0,3,0" VerticalAlignment="Stretch"
                                                            MinHeight="0" Padding="0"
                                                            Cursor="Hand" ToolTip="{Binding BreakLabel}"
                                                            AutomationProperties.Name="{Binding BreakLabel}"
                                                            Click="PageBreak_Click" Tag="{Binding Page.Id}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Rectangle x:Name="BreakLine" Width="1" Margin="0,10,0,10"
                                                                   Fill="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Opacity="0" />
                                                    </Button>
                                                <Grid Width="116" Height="128">
                                                    <!-- The page's text, read with OCR, on the clipboard. -->
                                                    <!-- Split or join the documents at the page, and name its document. -->
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Copy text" Click="PageCopyText_Click" Tag="{Binding Page.Id}" />
                                                            <Separator Visibility="{Binding HasSplitMenu, Converter={StaticResource BoolToVisibility}}" />
                                                            <MenuItem Header="{Binding MenuBreakLabel}"
                                                                      Visibility="{Binding HasMenuBreak, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageBreak_Click" Tag="{Binding Page.Id}" />
                                                            <MenuItem Header="Name this document…"
                                                                      Visibility="{Binding CanNameDocument, Converter={StaticResource BoolToVisibility}}"
                                                                      Click="PageName_Click" Tag="{Binding Page.Id}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <Border x:Name="Card" Style="{StaticResource CardStyle}" Padding="6"
                                                            ToolTip="{Binding SideLabel}">
                                                        <Image x:Name="Thumb" Source="{Binding Thumbnail}" MaxHeight="112" MaxWidth="104"
                                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <!-- A page that looks blank, or was skipped: what saving does with
                                                         it, and one click (always shown) to keep or skip it. -->
                                                    <StackPanel x:Name="BlankInfo" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Margin="0,0,0,10">
                                                        <Border x:Name="BlankBadge" HorizontalAlignment="Center" Padding="6,1,6,2"
                                                                CornerRadius="4" ToolTip="{Binding BadgeToolTip}"
                                                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7C3;" FontSize="11"
                                                                           Margin="0,1,4,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding BlankBadge}" Style="{StaticResource CaptionText}"
                                                                           TextWrapping="NoWrap" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button x:Name="BlankToggle" Style="{StaticResource PageToggleButtonStyle}"
                                                                Content="{Binding ToggleText}"
                                                                ToolTip="{Binding ToggleLabel}" AutomationProperties.Name="{Binding ToggleLabel}"
                                                                HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                Click="PageToggle_Click" Tag="{Binding Page.Id}" />
                                                    </StackPanel>
                                                    <!-- The top row: which side of which sheet on the left, and
                                                         the swap button on the right. The side badge takes the
                                                         room the button leaves, and wraps rather than cover it. -->
                                                    <DockPanel x:Name="TopRow" VerticalAlignment="Top" Margin="4,4,4,0">
                                                        <!-- A page crop and straighten changed: one click shows it as
                                                             scanned, and back. Always shown, on the page itself. -->
                                                        <Button x:Name="GeometryToggle" DockPanel.Dock="Right" Style="{StaticResource PageToggleButtonStyle}"
                                                                VerticalAlignment="Top" Margin="2,0,0,0"
                                                                Padding="4,2,4,2" FontFamily="{StaticResource IconFontFamily}" FontSize="11"
                                                                Content="{Binding GeometryGlyph}"
                                                                ToolTip="{Binding GeometryToolTip}"
                                                                AutomationProperties.Name="{Binding GeometryToggleLabel}"
                                                                AutomationProperties.HelpText="{Binding GeometryCaption}"
                                                                Click="PageGeometry_Click" Tag="{Binding Page.Id}" />
                                                        <StackPanel>
                                                            <!-- The first page of each document when the queue is split:
                                                                 "Document 2 · Lease" (the full name on hover). -->
                                                            <Border x:Name="DocumentBadge" Style="{StaticResource AccentTagStyle}"
                                                                    HorizontalAlignment="Left" Margin="0,0,0,2" ToolTip="{Binding DividerTitle}">
                                                                <TextBlock Text="{Binding DividerTitle}" Style="{StaticResource AccentTagText}"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="96" />
                                                            </Border>
                                                            <!-- Which side of which sheet, for two-sided stacks. -->
                                                            <Border x:Name="SideBadge" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Padding="5,0,5,1" CornerRadius="4" IsHitTestVisible="False"
                                                                    Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                                                <TextBlock Text="{Binding SideLabel}" Style="{StaticResource CaptionText}"
                                                                           TextWrapping="Wrap" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <Border x:Name="Actions" Style="{StaticResource HoverActionBarStyle}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76B;"
                                                                    ToolTip="Move page left"
                                                                    AutomationProperties.Name="Move page left"
                                                                    Click="PageLeft_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE7AD;"
                                                                    ToolTip="Rotate page 90° clockwise"
                                                                    AutomationProperties.Name="Rotate page 90° clockwise"
                                                                    Click="PageRotate_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE74D;"
                                                                    ToolTip="Remove page"
                                                                    AutomationProperties.Name="Remove page"
                                                                    Click="PageRemove_Click" Tag="{Binding Page.Id}" />
                                                            <Button Style="{StaticResource PageActionButtonStyle}" Content="&#xE76C;"
                                                                    ToolTip="Move page right"
                                                                    AutomationProperties.Name="Move page right"
                                                                    Click="PageRight_Click" Tag="{Binding Page.Id}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- The document's name ({label} in the file name), typed here. -->
                                                    <Popup x:Name="NamePopup" IsOpen="{Binding IsNaming, Mode=TwoWay}" StaysOpen="False"
                                                           PlacementTarget="{Binding ElementName=Card}" Placement="Top" AllowsTransparency="True"
                                                           Opened="NamePopup_Opened" Closed="NamePopup_Closed" Tag="{Binding Page.Id}">
                                                        <Border Style="{StaticResource CardStyle}" Padding="8" Width="240">
                                                            <StackPanel>
                                                                <TextBlock Text="Name this document" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                                <TextBox x:Name="NameBox" Text="{Binding NameDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="{x:Static core:DocumentSplitter.MaxLabelLength}"
                                                                         AutomationProperties.Name="Name this document"
                                                                         KeyDown="NameBox_KeyDown" Tag="{Binding Page.Id}" />
                                                                <TextBlock Text="Used for {label} in the file name. Enter saves, Esc cancels."
                                                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                </DockPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SideLabel}" Value="{x:Null}">
                                                        <Setter TargetName="SideBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DividerTitle}" Value="{x:Null}">
                                                        <Setter TargetName="DocumentBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=BreakButton}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=BreakButton}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StartsDocument}" Value="True">
                                                        <Setter TargetName="BreakLine" Property="Opacity" Value="1" />
                                                        <Setter TargetName="BreakLine" Property="Width" Value="3" />
                                                        <Setter TargetName="BreakLine" Property="Margin" Value="0" />
                                                        <Setter TargetName="BreakLine" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsBreaks}" Value="False">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowsBreaks}" Value="True">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasBreakButton}" Value="True">
                                                        <Setter TargetName="BreakButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding BlankBadge}" Value="{x:Null}">
                                                        <Setter TargetName="BlankBadge" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ToggleLabel}" Value="{x:Null}">
                                                        <Setter TargetName="BlankToggle" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding GeometryToggleLabel}" Value="{x:Null}">
                                                        <Setter TargetName="GeometryToggle" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <!-- Left out when saving: the page is dimmed. -->
                                                    <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                        <Setter TargetName="Thumb" Property="Opacity" Value="0.35" />
                                                    </DataTrigger>
                                                    <!-- Last, so it wins: a frozen page shows no actions. -->
                                                    <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False">
                                                        <Setter TargetName="Actions" Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Inspector: the settings scroll; the action buttons are pinned below
                             them so Preview/Scan can never be pushed out of the window. -->
                        <Grid Grid.Column="1" Width="280">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0" />
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="12" x:Name="Inspector">
                                    <Border x:Name="ModeTrack" Style="{StaticResource SegmentedTrackStyle}" Margin="0,0,0,12"
                                            AutomationProperties.Name="Scan mode" ToolTipService.ShowOnDisabled="True">
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="ModeDocument" Style="{StaticResource SegmentedItemStyle}"
                                                         Content="Document" local:Icon.Glyph="&#xE8A5;" IsChecked="True"
                                                         Checked="Setting_Changed" />
                                            <RadioButton x:Name="ModePhotos" Style="{StaticResource SegmentedItemStyle}"
                                                         Content="Photos" local:Icon.Glyph="&#xEB9F;"
                                                         Checked="Setting_Changed" />
                                        </UniformGrid>
                                    </Border>

                                    <!-- The Copy task only: where and how the copies print. Nothing opens a print
                                         dialog; the printer list and paper are read from Windows. -->
                                    <Expander x:Name="CopyOptions" Style="{StaticResource SectionExpanderStyle}"
                                              AutomationProperties.Name="Copies" Visibility="Collapsed">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE749;" Margin="0,0,12,0" />
                                                <TextBlock Text="Copies" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Printer" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="CopyPrinterBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Printer"
                                                      DropDownOpened="CopyPrinterBox_DropDownOpened"
                                                      SelectionChanged="CopyPrinter_Changed" />
                                            <TextBlock x:Name="CopyPaperText" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock x:Name="CopyNoPrinterText" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                                                       Text="No printer is installed. Add one in Windows Settings, then look again." />
                                            <Button x:Name="CopyLookAgainButton" Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Look again" HorizontalAlignment="Left" Margin="-11,4,0,0"
                                                    Visibility="Collapsed"
                                                    ToolTip="Reads the installed printers again"
                                                    Click="CopyLookAgain_Click" />
                                            <TextBlock Text="Number of copies" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="CopyCountBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Number of copies"
                                                      SelectionChanged="CopyCount_Changed" />
                                            <CheckBox x:Name="CopyFitBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                                                      Content="Fit to page"
                                                      Checked="CopyFit_Changed" Unchecked="CopyFit_Changed" />
                                            <TextBlock x:Name="CopyFitHint" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock x:Name="CopyMarginText" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed" />
                                            <CheckBox x:Name="CopyPdfBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                      Content="Also save a PDF"
                                                      ToolTip="Each copy is also saved as a PDF in the save folder"
                                                      Checked="CopyPdf_Changed" Unchecked="CopyPdf_Changed" />
                                            <Button x:Name="RulerButton" Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Print ruler test page" HorizontalAlignment="Left" Margin="-11,8,0,0"
                                                    ToolTip="Prints a 1-inch grid with centimetre ticks: measure it with a ruler to check that copies come out at real size"
                                                    Click="RulerPage_Click" />
                                        </StackPanel>
                                    </Expander>

                                    <!-- The Receipts task only: how the receipts found on the glass are named and saved. -->
                                    <Expander x:Name="ReceiptOptions" Style="{StaticResource SectionExpanderStyle}"
                                              AutomationProperties.Name="Receipts" Visibility="Collapsed">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE7BF;" Margin="0,0,12,0" />
                                                <TextBlock Text="Receipts" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <CheckBox x:Name="ReceiptDateBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="Name by the receipt's date"
                                                      Checked="ReceiptDate_Changed" Unchecked="ReceiptDate_Changed" />
                                            <TextBlock x:Name="ReceiptDateHint" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <CheckBox x:Name="ReceiptCombineBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                      Content="One PDF for all receipts" ToolTipService.ShowOnDisabled="True"
                                                      Checked="ReceiptCombine_Changed" Unchecked="ReceiptCombine_Changed" />
                                            <TextBlock x:Name="ReceiptCombineHint" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="Scanner">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8FE;" Margin="0,0,12,0" />
                                                <TextBlock Text="Scanner" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Source" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="SourceBox" Margin="{StaticResource FieldSpacing}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Source"
                                                      ToolTipService.ShowOnDisabled="True"
                                                      SelectionChanged="Setting_Changed" />
                                            <!-- Feeder sheets: one side, both, or turned over by hand. Choices the
                                                 scanner or the settings cannot do are greyed out with the reason;
                                                 the whole group is left out for a scanner without a feeder. -->
                                            <StackPanel x:Name="SidesOptions" Margin="{StaticResource FieldSpacing}">
                                                <TextBlock Text="Sides" Style="{StaticResource FieldLabelText}" />
                                                <ComboBox x:Name="SidesBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Sides"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          SelectionChanged="Sides_Changed" />
                                                <TextBlock x:Name="SidesHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <StackPanel x:Name="BackBindingOptions" Margin="0,8,0,0">
                                                    <TextBlock Text="Flip on" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="BackBindingBox" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="Back sides flip on"
                                                              ToolTip="How the sheets turn: the backs of short-edge sheets are turned upright."
                                                              SelectionChanged="Sides_Changed" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="Paper size" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="PaperSizeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Paper size"
                                                      SelectionChanged="PaperSize_Changed" />
                                            <TextBlock x:Name="PaperSizeHint" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,12" />
                                            <TextBlock Text="Resolution" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Resolution" ItemStringFormat="{}{0} dpi"
                                                      SelectionChanged="Setting_Changed" />
                                            <!-- TWAIN connections only: scan through the driver's own window. -->
                                            <StackPanel x:Name="DriverWindowOptions" Visibility="Collapsed" Margin="0,8,0,0">
                                                <CheckBox x:Name="DriverWindowBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Use the scanner's own settings window"
                                                          Checked="DriverWindow_Changed" Unchecked="DriverWindow_Changed" />
                                                <TextBlock x:Name="DriverWindowHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="Image">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE790;" Margin="0,0,12,0" />
                                                <TextBlock Text="Image" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Color" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="ColorModeBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Color" SelectionChanged="Setting_Changed" />
                                            <StackPanel x:Name="PhotoOptions" Visibility="Collapsed" Margin="0,8,0,0">
                                                <CheckBox x:Name="AutoSplitBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Auto-split photos" IsChecked="True"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                                <CheckBox x:Name="DeskewBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Auto-straighten (deskew)" IsChecked="True"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="Adjustments">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE9E9;" Margin="0,0,12,0" />
                                                <TextBlock Text="Adjustments" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <CheckBox x:Name="AutoEnhanceBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="Auto enhance"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="32" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Brightness" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="Brightness"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="BrightnessReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="1" Text="Contrast" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="1" Grid.Column="1" x:Name="ContrastSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="Contrast"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ContrastReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="2" Text="Saturation" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="2" Grid.Column="1" x:Name="SaturationSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="Saturation"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SaturationReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                                <TextBlock Grid.Row="3" Text="Sharpness" Style="{StaticResource SliderLabelText}" />
                                                <Slider Grid.Row="3" Grid.Column="1" x:Name="SharpnessSlider"
                                                        Style="{StaticResource CenteredSliderStyle}"
                                                        AutomationProperties.Name="Sharpness"
                                                        ToolTip="Positive sharpens, negative softens"
                                                        ValueChanged="Adjustment_Changed" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" x:Name="SharpnessReadout" Text="0"
                                                           Style="{StaticResource ReadoutText}" />
                                            </Grid>
                                            <Button x:Name="ResetSlidersButton" Style="{StaticResource SubtleButtonStyle}"
                                                    local:Icon.Glyph="&#xE7A7;" Content="Reset sliders"
                                                    HorizontalAlignment="Left" Margin="-11,4,0,4"
                                                    Click="ResetSliders_Click" />
                                            <CheckBox x:Name="DescreenBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="Descreen (printed material)"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                            <CheckBox x:Name="RestoreBox" Style="{StaticResource ToggleSwitchStyle}"
                                                      Content="Restore faded colors"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{StaticResource SectionExpanderStyle}" AutomationProperties.Name="Output">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74E;" Margin="0,0,12,0" />
                                                <TextBlock Text="Output" Style="{StaticResource BodyStrongText}" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Text="Format" Style="{StaticResource FieldLabelText}" />
                                            <ComboBox x:Name="FormatBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="Format" SelectionChanged="Format_Changed" />
                                            <!-- PDF output only: how small the file is made. The segments
                                                 (largest first) are added in code from PdfSizePresets. -->
                                            <StackPanel x:Name="PdfSizeOptions" Margin="0,12,0,0">
                                                <TextBlock Text="PDF size" Style="{StaticResource FieldLabelText}" />
                                                <Border Style="{StaticResource SegmentedTrackStyle}"
                                                        AutomationProperties.Name="PDF size">
                                                    <UniformGrid x:Name="PdfSizeSegments" Rows="1" />
                                                </Border>
                                                <TextBlock x:Name="PdfSizeHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <TextBlock x:Name="LastPdfSizeText" Style="{StaticResource CaptionText}"
                                                           TextWrapping="NoWrap" Margin="0,2,0,0"
                                                           Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                                            </StackPanel>
                                            <StackPanel x:Name="DocumentOptions" Margin="0,8,0,0">
                                                <CheckBox x:Name="MultiPageBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Collect pages, then Save PDF"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                                <CheckBox x:Name="SearchableBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Searchable PDF (OCR)"
                                                          ToolTip="Text is recognized automatically — nothing to configure."
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                                <!-- The text of the pages in a .txt file beside each PDF; OCR reads each page once for both. -->
                                                <CheckBox x:Name="AlsoSaveTextBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Also save text (.txt)" ToolTipService.ShowOnDisabled="True"
                                                          Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                                <!-- Blank pages: flagged in the page strip, left out when saving. The
                                                     sensitivity segments (least first) are added in code. -->
                                                <CheckBox x:Name="SkipBlankBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Skip blank pages" ToolTipService.ShowOnDisabled="True"
                                                          Checked="BlankPages_Changed" Unchecked="BlankPages_Changed" />
                                                <TextBlock x:Name="SkipBlankHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <StackPanel x:Name="BlankSensitivityOptions" Margin="0,4,0,0">
                                                    <TextBlock Text="What counts as blank" Style="{StaticResource FieldLabelText}" />
                                                    <Border Style="{StaticResource SegmentedTrackStyle}"
                                                            AutomationProperties.Name="What counts as blank">
                                                        <UniformGrid x:Name="BlankSensitivitySegments" Rows="1" />
                                                    </Border>
                                                    <TextBlock x:Name="BlankSensitivityHint" Style="{StaticResource CaptionText}"
                                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <!-- Crop and straighten: changed pages carry a swap button in the page strip. -->
                                                <CheckBox x:Name="AutoCropBox" Style="{StaticResource ToggleSwitchStyle}" Margin="0,8,0,0"
                                                          Content="Crop to page" ToolTipService.ShowOnDisabled="True"
                                                          Checked="Geometry_Changed" Unchecked="Geometry_Changed" />
                                                <CheckBox x:Name="AutoStraightenBox" Style="{StaticResource ToggleSwitchStyle}"
                                                          Content="Straighten pages" ToolTipService.ShowOnDisabled="True"
                                                          Checked="Geometry_Changed" Unchecked="Geometry_Changed" />
                                                <TextBlock x:Name="GeometryHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <!-- Split the stack into documents: the page strip shows where before
                                                     saving, and one click on the gap between two pages splits or joins. -->
                                                <TextBlock Text="Split into documents" Style="{StaticResource FieldLabelText}" Margin="0,8,0,4" />
                                                <ComboBox x:Name="SplitModeBox" HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Split into documents"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          SelectionChanged="SplitMode_Changed" />
                                                <StackPanel x:Name="SplitCountRow" Margin="0,8,0,0">
                                                    <TextBlock Text="Sheets per document" Style="{StaticResource FieldLabelText}" />
                                                    <ComboBox x:Name="SplitCountBox" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="Sheets per document"
                                                              SelectionChanged="SplitCount_Changed" />
                                                </StackPanel>
                                                <TextBlock x:Name="SplitHint" Style="{StaticResource CaptionText}"
                                                           TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <!-- The separator sheet: a PDF to print anywhere, or printed here. -->
                                                <Button x:Name="SaveSeparatorButton" Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Save separator sheet (PDF)" HorizontalAlignment="Left" Margin="-11,4,0,0"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Click="SaveSeparator_Click" />
                                                <Button x:Name="PrintSeparatorButton" Style="{StaticResource SubtleButtonStyle}"
                                                        Content="Print separator sheet" HorizontalAlignment="Left" Margin="-11,0,0,4"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        Click="PrintSeparator_Click" />
                                            </StackPanel>
                                            <TextBlock Text="After saving" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <ComboBox x:Name="AfterSaveBox" HorizontalAlignment="Stretch"
                                                      AutomationProperties.Name="After saving"
                                                      SelectionChanged="AfterSave_Changed" />
                                            <TextBlock Text="Save to" Style="{StaticResource FieldLabelText}" Margin="0,12,0,4" />
                                            <DockPanel Margin="{StaticResource FieldSpacing}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE838;"
                                                        ToolTip="Choose the save folder"
                                                        AutomationProperties.Name="Choose the save folder"
                                                        Click="BrowseDestination_Click" />
                                                <TextBox x:Name="DestinationBox" Margin="0,0,4,0"
                                                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                         ScrollViewer.ScrollChanged="DestinationBox_ScrollChanged"
                                                         LostKeyboardFocus="DestinationBox_LostKeyboardFocus"
                                                         AutomationProperties.Name="Save to" LostFocus="Setting_Changed" />
                                            </DockPanel>
                                            <TextBlock Text="File name" Style="{StaticResource FieldLabelText}" />
                                            <TextBox x:Name="TemplateBox" AutomationProperties.Name="File name"
                                                     LostFocus="Setting_Changed" />
                                            <TextBlock Text="Tokens: {date} {time} {counter} {intent} {task} {label}"
                                                       Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Pinned actions: Scan is the primary action. -->
                            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,0,0" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreviewButton" Style="{StaticResource IconTextButtonStyle}"
                                                local:Icon.Glyph="&#xE8FF;" Content="Preview"
                                                HorizontalAlignment="Stretch" MinHeight="36"
                                                ToolTip="Quick low-resolution scan of the whole glass"
                                                Click="Preview_Click" />
                                        <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                                local:Icon.Glyph="&#xE8FE;" Content="Scan" MinHeight="36"
                                                Click="Scan_Click" />
                                    </Grid>
                                    <Grid x:Name="QueueButtons" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="SavePdfButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                                local:Icon.Glyph="&#xEA90;" Content="Save PDF" ToolTip="Save PDF" MinHeight="36"
                                                Click="SavePdf_Click" />
                                        <Button Grid.Column="2" x:Name="ClearButton" Style="{StaticResource IconButtonStyle}"
                                                Content="&#xE74D;" Width="36" Height="36"
                                                ToolTip="Remove every page from the queue"
                                                AutomationProperties.Name="Clear"
                                                Click="ClearPages_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Scans" x:Name="ScansTab" local:Icon.Glyph="&#xE81C;">
                    <local:ScanHistoryView x:Name="HistoryView" />
                </TabItem>

                <TabItem Header="Saved" x:Name="SavedTab" local:Icon.Glyph="&#xE8B7;">
                    <local:SavedFilesView x:Name="SavedView" />
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- Photo review dialog (leaves the status bar, with its Cancel button, reachable) -->
        <Grid Grid.Row="1" x:Name="PhotoReviewOverlay" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource DialogCardStyle}" MaxWidth="960" MaxHeight="680" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="24,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ReviewDiscardButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74D;" Content="Discard" MinWidth="120"
                                        Click="ReviewCancel_Click" />
                                <Button x:Name="ReviewSaveButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74E;" Content="Save Photos" MinWidth="120"
                                        HorizontalAlignment="Right" Margin="8,0,0,0"
                                        Click="ReviewSave_Click" />
                            </StackPanel>
                            <!-- The same setting as the inspector's "After saving". -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock x:Name="ReviewAfterSaveLabel" Text="After saving" Style="{StaticResource BodyText}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="ReviewAfterSaveBox" MinWidth="140" MaxWidth="180"
                                          AutomationProperties.Name="After saving"
                                          SelectionChanged="AfterSave_Changed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="24,20,24,12">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock x:Name="ReviewTitle" Text="Detected photos" Style="{StaticResource SubtitleText}" />
                                <TextBlock Text="Untick any false positives, or fix a crop."
                                           Style="{StaticResource SecondaryBodyText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <!-- The right margin puts the scrollbar in the dialog's padding, clear of the cards. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="-6,0,-18,0">
                                <ItemsControl x:Name="PhotoGrid" Margin="0,0,12,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="208" Margin="6">
                                                <Border x:Name="Card" Style="{StaticResource CardStyle}">
                                                    <StackPanel>
                                                        <Border x:Name="Well" Style="{StaticResource ImageWellStyle}" Height="160">
                                                            <Viewbox StretchDirection="DownOnly" Margin="5">
                                                                <Image Source="{Binding Thumbnail}" MaxHeight="150" MaxWidth="190"
                                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                                    <Image.LayoutTransform>
                                                                        <RotateTransform Angle="{Binding RotationDegrees}" />
                                                                    </Image.LayoutTransform>
                                                                </Image>
                                                            </Viewbox>
                                                        </Border>
                                                        <DockPanel Margin="0,8,0,0">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                                    Content="&#xE7AD;" ToolTip="Rotate 90° clockwise"
                                                                    AutomationProperties.Name="Rotate 90° clockwise"
                                                                    Click="ReviewRotate_Click" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                                    Content="&#xE7A8;" ToolTip="Adjust the crop manually"
                                                                    AutomationProperties.Name="Adjust the crop manually"
                                                                    Click="ReviewCrop_Click" />
                                                            <CheckBox Content="Keep" IsChecked="{Binding Included}" Click="ReviewKeep_Click"
                                                                      VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                                <Border x:Name="Ring" CornerRadius="{StaticResource CardCornerRadius}" BorderThickness="2"
                                                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                        IsHitTestVisible="False" Visibility="Collapsed" />
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Included}" Value="True">
                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Included}" Value="False">
                                                    <Setter TargetName="Well" Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ID card review: both sides, the page they go on, and saving. Modal like the photo
             review, leaving the status bar (with its Cancel button) reachable. -->
        <Grid Grid.Row="1" x:Name="IdCardReviewOverlay" Background="{DynamicResource SmokeFillColorDefaultBrush}"
              Visibility="Collapsed">
            <Border Style="{StaticResource DialogCardStyle}" MaxWidth="900" MaxHeight="720" Margin="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="24,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="IdCardPrintButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE749;" Content="Print" MinWidth="110" Margin="0,0,8,0"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="IdCardPrint_Click" />
                                <Button x:Name="IdCardDiscardButton" Style="{StaticResource IconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74D;" Content="Discard" MinWidth="110"
                                        ToolTip="Drop both sides without saving them"
                                        Click="IdCardDiscard_Click" />
                                <Button x:Name="IdCardSaveButton" Style="{StaticResource AccentIconTextButtonStyle}"
                                        local:Icon.Glyph="&#xE74E;" Content="Save" MinWidth="110" Margin="8,0,0,0"
                                        Click="IdCardSave_Click" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock x:Name="IdCardPaperLabel" Text="Paper" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="IdCardPaperBox" MinWidth="150" AutomationProperties.Name="Paper"
                                              ToolTip="The page both sides are laid out on"
                                              SelectionChanged="IdCardPaper_Changed" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,6">
                                    <TextBlock x:Name="IdCardFormatLabel" Text="Save as" Style="{StaticResource BodyText}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="IdCardFormatBox" MinWidth="90" AutomationProperties.Name="Save as"
                                              SelectionChanged="IdCardFormat_Changed" />
                                </StackPanel>
                                <CheckBox x:Name="IdCardSidesBox" Content="Also save each side as an image"
                                          VerticalAlignment="Center" Margin="0,0,0,6"
                                          ToolTip="Each side is saved as a picture of its own too, next to the page"
                                          Click="IdCardSides_Click" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource LayerFillColorAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" Padding="24,20,24,16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                <TextBlock x:Name="IdCardReviewTitle" Text="Check the ID card" Style="{StaticResource SubtitleText}" />
                                <TextBlock Text="Both sides go on one page at their real size. The scans stay on this PC: they are not kept in the Scans tab, and are cleared once you save or discard them."
                                           Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,-18,0">
                                <WrapPanel Margin="0,0,18,0">
                                    <!-- The sides: each with its turn, its crop and scanning it again. -->
                                    <StackPanel Width="300" Margin="0,0,24,12">
                                        <Border x:Name="IdCardFrontCard" Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                                                AutomationProperties.Name="Front side">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE72C;" Tag="front" ToolTip="Scan the front again"
                                                            AutomationProperties.Name="Scan the front again"
                                                            Click="IdCardRetake_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardFrontCropButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7A8;" Tag="front" ToolTip="Fix the crop of the front"
                                                            AutomationProperties.Name="Fix the crop of the front"
                                                            Click="IdCardCrop_Click" />
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7AD;" Tag="front" ToolTip="Turn the front 90° clockwise"
                                                            AutomationProperties.Name="Turn the front 90° clockwise"
                                                            Click="IdCardRotate_Click" />
                                                    <TextBlock Text="Front" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Border Style="{StaticResource ImageWellStyle}" Height="170" Margin="0,8,0,0">
                                                    <Image x:Name="IdCardFrontImage" Margin="8" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.LayoutTransform>
                                                            <RotateTransform x:Name="IdCardFrontTurn" />
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Border>
                                                <DockPanel x:Name="IdCardFrontNotice" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="IdCardFrontNoteText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="IdCardBackCard" Style="{StaticResource CardStyle}" AutomationProperties.Name="Back side">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackRetakeButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE72C;" Tag="back" ToolTip="Scan the back again"
                                                            AutomationProperties.Name="Scan the back again"
                                                            Click="IdCardRetake_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackCropButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7A8;" Tag="back" ToolTip="Fix the crop of the back"
                                                            AutomationProperties.Name="Fix the crop of the back"
                                                            Click="IdCardCrop_Click" />
                                                    <Button DockPanel.Dock="Right" x:Name="IdCardBackRotateButton" Style="{StaticResource SmallIconButtonStyle}"
                                                            Content="&#xE7AD;" Tag="back" ToolTip="Turn the back 90° clockwise"
                                                            AutomationProperties.Name="Turn the back 90° clockwise"
                                                            Click="IdCardRotate_Click" />
                                                    <TextBlock Text="Back" Style="{StaticResource BodyStrongText}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <Border x:Name="IdCardBackWell" Style="{StaticResource ImageWellStyle}" Height="170" Margin="0,8,0,0">
                                                    <Image x:Name="IdCardBackImage" Margin="8" Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.LayoutTransform>
                                                            <RotateTransform x:Name="IdCardBackTurn" />
                                                        </Image.LayoutTransform>
                                                    </Image>
                                                </Border>
                                                <StackPanel x:Name="IdCardNoBack" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock Text="No back side. Scan it if something is printed on the back."
                                                               Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" />
                                                    <Button x:Name="IdCardScanBackButton" Style="{StaticResource SubtleButtonStyle}"
                                                            local:Icon.Glyph="&#xE8FE;" Content="Scan the back" Tag="back"
                                                            HorizontalAlignment="Left" Margin="-11,4,0,0"
                                                            Click="IdCardRetake_Click" />
                                                </StackPanel>
                                                <DockPanel x:Name="IdCardBackNotice" Visibility="Collapsed" Margin="0,8,0,0">
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                               Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <TextBlock x:Name="IdCardBackNoteText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="IdCardSwapButton" Style="{StaticResource SubtleButtonStyle}"
                                                local:Icon.Glyph="&#xE8AB;" Content="Swap front and back"
                                                HorizontalAlignment="Left" Margin="-11,8,0,0"
                                                ToolTip="The sides were scanned the other way round"
                                                Click="IdCardSwap_Click" />
                                    </StackPanel>
                                    <!-- The page both sides go on, drawn small. -->
                                    <StackPanel Width="300" Margin="0,0,0,12">
                                        <TextBlock Text="The page" Style="{StaticResource BodyStrongText}" Margin="0,0,0,8" />
                                        <Border HorizontalAlignment="Left" Background="White" Effect="{DynamicResource PageShadow}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
                                            <Image x:Name="IdCardPageImage" Height="380" Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   AutomationProperties.Name="The page both sides are saved on" />
                                        </Border>
                                        <TextBlock x:Name="IdCardLayoutText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                   Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                                        <DockPanel x:Name="IdCardSizeNotice" Visibility="Collapsed" Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;"
                                                       Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <TextBlock x:Name="IdCardSizeText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Assertive" />
                                        </DockPanel>
                                    </StackPanel>
                                </WrapPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0"
                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" MinHeight="36" Padding="8,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="True" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="BusyBar" Width="160" VerticalAlignment="Center" Margin="0,0,12,0"
                                 AutomationProperties.Name="Progress" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Style="{StaticResource IconTextButtonStyle}"
                            local:Icon.Glyph="&#xE711;" Content="Cancel" Padding="10,3,10,4"
                            Visibility="Collapsed" Click="Cancel_Click" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Looking for scanners…" Style="{StaticResource CaptionText}"
                           FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
