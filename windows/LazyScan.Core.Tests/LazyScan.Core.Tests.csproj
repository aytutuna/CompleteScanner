<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Test-only (Apache-2.0): opens the PDFs the writer makes to check their structure, text
         layer and metadata. Never referenced by Core or the App. -->
    <PackageReference Include="PdfPig" Version="[0.1.16]" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyScan.Core\LazyScan.Core.csproj" />
  </ItemGroup>

  <!-- The eSCL fixtures both test suites read (Tests/Fixtures/Escl at the repository root; the Swift
       suite reads the same files): capability documents, request snapshots, a TXT record, scanner
       certificates and trust files from either platform. -->
  <ItemGroup>
    <None Include="..\..\Tests\Fixtures\Escl\**\*" LinkBase="Fixtures\Escl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
