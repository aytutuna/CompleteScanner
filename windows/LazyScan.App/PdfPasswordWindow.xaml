<Window x:Class="LazyScan.App.PdfPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyScan.App"
        xmlns:core="clr-namespace:LazyScan.Core;assembly=LazyScan.Core"
        Title="{x:Static core:PdfProtection.DialogTitle}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="Save" IsDefault="True" MinWidth="96" IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,16">
            <TextBlock Text="{x:Static core:PdfProtection.DialogTitle}" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <!-- What can't be undone, and that it applies to every save from now on: always shown. -->
            <DockPanel Margin="0,8,0,16" Background="Transparent"
                       AutomationProperties.HelpText="{x:Static core:PdfProtection.DialogHelp}">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE7BA;" FontSize="14"
                           Margin="0,2,8,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="WarningText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           Text="{x:Static core:PdfProtection.DialogMessage}" />
            </DockPanel>

            <!-- The password is read from the boxes only when needed and the boxes are emptied when
                 the dialog closes; it is never put in settings or anywhere else. -->
            <TextBlock x:Name="PasswordLabel" Text="Password" Style="{StaticResource FieldLabelText}" />
            <PasswordBox x:Name="PasswordInput" AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
                         PasswordChanged="Password_Changed" PreviewKeyDown="Password_PreviewKeyDown" />
            <!-- How hard it is to guess: a bar of four segments and a few words; the full advice on hover. -->
            <DockPanel x:Name="StrengthPanel" Margin="0,6,0,0" Visibility="Collapsed" Background="Transparent">
                <UniformGrid x:Name="StrengthBar" DockPanel.Dock="Left" Rows="1" Columns="4" Width="96" Height="4"
                             VerticalAlignment="Center" Margin="0,1,10,0">
                    <Border Margin="0,0,3,0" CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                    <Border Margin="0,0,3,0" CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                    <Border Margin="0,0,3,0" CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                    <Border CornerRadius="2" Background="{DynamicResource ControlStrongFillColorDisabledBrush}" />
                </UniformGrid>
                <TextBlock x:Name="StrengthText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>

            <TextBlock x:Name="ConfirmLabel" Text="Confirm" Style="{StaticResource FieldLabelText}" Margin="0,12,0,0" />
            <PasswordBox x:Name="ConfirmInput" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmLabel}"
                         PasswordChanged="Password_Changed" PreviewKeyDown="Password_PreviewKeyDown"
                         LostKeyboardFocus="Confirm_LostKeyboardFocus" />
            <!-- Hidden, not collapsed, when there is no message: its line stays, so the message
                 appearing does not move the checkboxes under it. -->
            <DockPanel x:Name="ProblemPanel" Margin="0,6,0,0" Visibility="Hidden">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xEB90;" Margin="0,1,8,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="ProblemText" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </DockPanel>

            <!-- What PDF apps may let a reader do once the file is open: advisory, and said so. -->
            <CheckBox x:Name="AllowPrintingBox" Content="Allow printing" IsChecked="True" Margin="0,16,0,0" />
            <CheckBox x:Name="AllowCopyingBox" Content="Allow copying" IsChecked="True" Margin="0,4,0,0"
                      AutomationProperties.Name="Allow copying text and images" />
            <!-- The permissions are a request, not a lock: always said, so they are not taken for one. -->
            <DockPanel Margin="0,6,0,0" Background="Transparent"
                       ToolTip="{x:Static core:PdfProtection.PermissionsNote}"
                       AutomationProperties.HelpText="{x:Static core:PdfProtection.PermissionsNote}">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ReasonGlyph}" Text="&#xE946;" />
                <TextBlock Style="{StaticResource ReasonText}" Text="{x:Static core:PdfProtection.PermissionsShortNote}" />
            </DockPanel>
        </StackPanel>
    </DockPanel>
</Window>
