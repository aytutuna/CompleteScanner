<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 gives access to WinRT APIs (Windows.Media.Ocr) from WPF via CsWinRT. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>LazyScan.App</RootNamespace>
    <AssemblyName>LazyScan</AssemblyName>
    <Product>Lazy Scan</Product>
    <AssemblyTitle>Lazy Scan</AssemblyTitle>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Explorer, the taskbar and Alt+Tab; the windows load the same file as a resource. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyScan.Core\LazyScan.Core.csproj" />
    <!-- The 32-bit TWAIN helper (x86): built with the app, not referenced as an assembly; its files
         are copied next to LazyScan.exe by the target below. -->
    <ProjectReference Include="..\LazyScan.TwainHelper\LazyScan.TwainHelper.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LazyScan.App.Tests" />
  </ItemGroup>

  <!-- Puts the helper's own files (its exe, assembly, runtime and dependency manifests) next to the
       app's, wherever the helper was built (artifacts output included). Its other files, the Core
       library and NTwain, are the app's own. As copy-to-output items they also reach projects that
       reference the app (its tests). -->
  <Target Name="AddTwainHelperFiles" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\LazyScan.TwainHelper\LazyScan.TwainHelper.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_TwainHelperTarget" />
    </MSBuild>
    <PropertyGroup>
      <_TwainHelperDir>@(_TwainHelperTarget->'%(RootDir)%(Directory)')</_TwainHelperDir>
    </PropertyGroup>
    <ItemGroup>
      <_TwainHelperFile Include="$(_TwainHelperDir)LazyScan.TwainHelper.exe;$(_TwainHelperDir)LazyScan.TwainHelper.dll;$(_TwainHelperDir)LazyScan.TwainHelper.runtimeconfig.json;$(_TwainHelperDir)LazyScan.TwainHelper.deps.json" />
      <None Include="@(_TwainHelperFile)" CopyToOutputDirectory="PreserveNewest" Visible="false"
            Link="%(_TwainHelperFile.Filename)%(_TwainHelperFile.Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- TWAIN (Scanning/Twain). MIT licensed, no dependencies; pinned to an exact version.
         The TWAIN Data Source Manager it loads (TWAINDSM.dll, LGPL) is never shipped with
         the app: scanner drivers install it. -->
    <PackageReference Include="NTwain" Version="[3.7.6]" />
    <!-- Barcode and QR separator sheets (Services/ZXingBarcodeReader.cs, ZXingQrEncoder.cs).
         Apache-2.0, no dependencies; the core package only, fed the page's gray pixels, so no
         image-binding package is needed. Pinned to an exact version. -->
    <PackageReference Include="ZXing.Net" Version="[0.16.11]" />
    <!-- The page corner model (Services/OnnxCornerModel.cs), on the CPU. MIT licensed; the same
         ONNX Runtime release as the Mac and the iPhone. Pinned to an exact version. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="[1.24.2]" />
  </ItemGroup>

  <!-- DocAligner's FastViT-T8 and its licence, into Models next to the app, from the folder
       scripts/fetch_docaligner.sh fetches the model into. Builds without it go on, and the photo import
       then uses its own page search. -->
  <ItemGroup Condition="Exists('..\..\Sources\LazyScanModel\Models\fastvit_t8_h_e_bifpn_256_fp32.onnx')">
    <None Include="..\..\Sources\LazyScanModel\Models\fastvit_t8_h_e_bifpn_256_fp32.onnx;..\..\Sources\LazyScanModel\Models\DocAligner-LICENSE.txt"
          Link="Models\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
