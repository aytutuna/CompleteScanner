<Window x:Class="LazyScan.App.TroubleshooterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:LazyScan.App"
        Title="Why isn't my scanner listed?"
        Width="600" Height="700" MinWidth="440" MinHeight="380" ResizeMode="CanResize"
        FontFamily="{StaticResource TextFontFamily}"
        Icon="{x:Static ui:AppIcon.Image}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <!-- Footer: copy the diagnostics on the left, look again and close on the right. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooterStyle}" Padding="24,14,24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="Refresh" ui:Icon.Glyph="&#xE72C;" MinWidth="96"
                            Style="{StaticResource IconTextButtonStyle}"
                            ToolTip="Check again"
                            AutomationProperties.HelpText="Looks for scanners again and repeats the checks"
                            Click="Refresh_Click" />
                    <Button x:Name="CloseButton" Content="Close" IsCancel="True" IsDefault="True" MinWidth="96" Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <Button x:Name="CopyButton" DockPanel.Dock="Left" Content="Copy diagnostics" ui:Icon.Glyph="&#xE8C8;"
                        Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Left"
                        ToolTip="Copy the results to send to support"
                        AutomationProperties.HelpText="Copies these checks and the list of connections as text"
                        Click="Copy_Click" />
                <TextBlock x:Name="FooterStatus" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                           Margin="8,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- Header: what is listed and how many things to look at, in one line; "Looking for scanners…"
             while a Refresh runs. -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <TextBlock Text="Why isn't my scanner listed?" Style="{StaticResource SubtitleText}" TextWrapping="Wrap" />
            <TextBlock x:Name="HeadlineText" Style="{StaticResource BodyStrongText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryBodyText}" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.LiveSetting="Polite" Visibility="Collapsed" />
        </StackPanel>

        <!-- One card per check that needs a look (see TroubleshooterWindow.xaml.cs): problems, warnings
             and tips, each with its first sentence, its buttons and "More help"; a compact row for each
             check that passed. -->
        <ScrollViewer x:Name="ChecksScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False" Padding="24,0,24,16">
            <StackPanel x:Name="ChecksPanel" AutomationProperties.Name="Checks"
                        KeyboardNavigation.TabNavigation="Continue" />
        </ScrollViewer>
    </DockPanel>
</Window>
