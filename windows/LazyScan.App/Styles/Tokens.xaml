<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Spacing -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <Thickness x:Key="PanePadding">12,8,12,12</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,8</Thickness>
    <Thickness x:Key="FieldSpacing">0,0,0,12</Thickness>
    <Thickness x:Key="LabelSpacing">0,0,0,4</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThumbnailCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="LayerCornerRadius">8,0,0,0</CornerRadius>

    <!-- Fonts -->
    <FontFamily x:Key="TextFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFontFamily">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Brushes that need alpha over the accent -->
    <SolidColorBrush x:Key="MarqueeFillBrush" Color="{DynamicResource {x:Static SystemColors.AccentColorKey}}" Opacity="0.18" />

    <!-- Elevation (swapped to null in high contrast by code) -->
    <DropShadowEffect x:Key="CardHoverShadow" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.18" />
    <DropShadowEffect x:Key="PageShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28" />
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.30" />
</ResourceDictionary>
